# Подробно: README, раздел «Подключение к Keitaro»

# Адрес трекера без /admin, например https://keitaro.example.com
KEITARO_URL=
# Админка Keitaro → Профиль → API ключи
KEITARO_API_KEY=
NAME_PREFIX=test_Zaitsev_
DATABASE_URL=sqlite:///./app.db

# Домен, группа и источник новой кампании: id выводит `python scripts/recon.py`
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_SOURCE_ID=

# JSON-список Host, на которые отвечает приложение (по умолчанию ["localhost","127.0.0.1"])
ALLOWED_HOSTS=
